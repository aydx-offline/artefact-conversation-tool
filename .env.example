# Copy to .env and fill in. .env is never committed.

# The GLM endpoint and key. The default is Zhipu's own; the final runs used Paratera's.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# Two different models. The final runs used glm-5.3-flash to write and GLM-5.3 to judge.
WRITER_MODEL=
JUDGE_MODEL=

# Seconds per call, and how hard each model reasons: none, low, medium, or high.
# The writer defaults to none. Leave the judge empty to use the model's own setting.
GLM_TIMEOUT=60
JUDGE_TIMEOUT=300
WRITER_REASONING=none
JUDGE_REASONING=

# Cases run at the same time, in batch and evaluate.
CA_WORKERS=2

# Optional. With no keys the tool runs the same and sends nothing to Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
